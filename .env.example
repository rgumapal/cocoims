# Local Docker Postgres (cocoims-db) — see docker-compose.yml
# Copy to .env and adjust if needed. .env is gitignored.

POSTGRES_DB=cocoims
POSTGRES_USER=cocoims
POSTGRES_PASSWORD=change_me_local_dev_only
POSTGRES_HOST_PORT=5433

# Used by backend/alembic to connect from the host (outside the compose network).
# Port matches POSTGRES_HOST_PORT above; 5432 was already taken by another
# project's container on this machine, so cocoims-db is published on 5433.
# Owning/superuser role — Alembic and admin scripts only. The running API
# must NOT use this: it bypasses RLS unconditionally (superusers always do,
# regardless of FORCE ROW LEVEL SECURITY — see alembic/versions/
# 0004_operational_rls_and_rpt.py).
DATABASE_URL=postgresql+psycopg2://cocoims:change_me_local_dev_only@localhost:5433/cocoims

# Unprivileged role (NOSUPERUSER, NOBYPASSRLS), created by migration 0004.
# The running API connects as this role, so RLS policies actually bind.
APP_DATABASE_URL=postgresql+psycopg2://cocoims_app:change_me_local_dev_only@localhost:5433/cocoims

# Signs access/refresh JWTs. Generate a real secret for anything beyond a
# single developer's machine — this default is not safe to share.
JWT_SECRET_KEY=change_me_local_dev_only
