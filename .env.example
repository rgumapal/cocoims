# Cloud SQL (cocoims:asia-southeast1:cocoims-db) via the Cloud SQL Auth
# Proxy — this is the default dev target, not a local Postgres container
# (see CLAUDE.md's "Local development database" section for why: a
# prototype with no live client data yet, Cloud SQL bills for uptime not
# query volume, and one database means no local/prod migration drift).
# Copy to .env, fill in the real passwords (ask a teammate or check Secret
# Manager — never commit real values), and run:
#   cloud-sql-proxy --port 5433 cocoims:asia-southeast1:cocoims-db
# before starting the backend. .env is gitignored.

# Owning/superuser-equivalent role — Alembic and admin scripts only. The
# running API must NOT use this: it bypasses RLS unconditionally
# (superusers always do, regardless of FORCE ROW LEVEL SECURITY — see
# alembic/versions/0004_operational_rls_and_rpt.py).
DATABASE_URL=postgresql+psycopg2://cocoims:changeme@127.0.0.1:5433/cocoims

# Unprivileged role (NOSUPERUSER, NOBYPASSRLS), created by migration 0004.
# The running API connects as this role, so RLS policies actually bind.
APP_DATABASE_URL=postgresql+psycopg2://cocoims_app:changeme@127.0.0.1:5433/cocoims

# Signs access/refresh JWTs. Generate a real secret for anything beyond a
# single developer's machine — this default is not safe to share.
JWT_SECRET_KEY=change_me_local_dev_only

# Only used if you deliberately spin up the local Docker Postgres instead
# (docker-compose.yml) — e.g. to iterate on a risky migration before it
# touches the real thing. Not the default dev path; see above.
POSTGRES_DB=cocoims
POSTGRES_USER=cocoims
POSTGRES_PASSWORD=change_me_local_dev_only
POSTGRES_HOST_PORT=5433
