# Local dev only — gitignored (see root .gitignore's bare ".env" pattern).
# Copy to .env; these values already work (Firebase's apiKey is not a
# secret by Firebase's own design — it identifies the project, not a
# credential; access is governed by Authorized domains and Firebase Auth
# rules, not by hiding this value). Same values the deploy skill bakes
# into the production build.

VITE_FIREBASE_API_KEY=AIzaSyB6jl2yHbS5gVrJSjYt-SK6We2gFUbCST8
VITE_FIREBASE_AUTH_DOMAIN=cocoims.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cocoims
VITE_FIREBASE_APP_ID=1:107351275174:web:865d30b32dea5ff8542667
